{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nap Wallet",
  "version": "0.3.0",
  "identifier": "io.infinityteam.napwallet",
  "build": {
    "beforeBuildCommand": "npm --prefix ../nap-web run build:mobile",
    "beforeDevCommand": "npm --prefix ../nap-web run build:mobile",
    "frontendDist": "../../nap-web/dist-mobile"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.0",
      "developmentTeam": "728D69ULX3",
      "bundleVersion": "3"
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
