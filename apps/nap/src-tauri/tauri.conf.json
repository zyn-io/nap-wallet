{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nap Wallet",
  "version": "0.1.0",
  "identifier": "io.infinityteam.napwallet",
  "build": {
    "beforeBuildCommand": "node build-ui.mjs",
    "beforeDevCommand": "node build-ui.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "Nap Wallet", "width": 1040, "height": 820, "minWidth": 640, "minHeight": 560 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
