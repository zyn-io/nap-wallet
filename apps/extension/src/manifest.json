{
  "manifest_version": 3,
  "name": "Nap Wallet",
  "version": "0.1.0",
  "description": "Your Nap Wallet in the toolbar, and a window.zyn provider for sites — backed by the wallet app running on your machine. Holds no keys.",
  "icons": { "32": "icons/32.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Nap Wallet" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8977/*"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }],
  "web_accessible_resources": [{ "resources": ["inpage.js"], "matches": ["<all_urls>"] }]
}
